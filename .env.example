# ─────────────────────────────────────────────────────────────
# CORE  (required)
# ─────────────────────────────────────────────────────────────
# Neon Postgres — https://neon.tech  (free tier)
#
# Use JOBFINDER_DATABASE_URL, not DATABASE_URL. A machine-wide DATABASE_URL is
# common (Prisma, Docker, other projects set one) and it OUTRANKS this file —
# neither dotenv nor Next.js override a variable already in the shell. The app
# reads JOBFINDER_DATABASE_URL first so a stray global cannot hijack it.
JOBFINDER_DATABASE_URL="postgresql://user:pass@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Optional fallback, used only when the above is unset.
DATABASE_URL="postgresql://user:pass@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Password you type to open the dashboard. Anything you like.
APP_PASSWORD="change-me-to-something-long"
# Random 32+ char string. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-random-32-chars-minimum-please"
# Random string. Cron endpoints require this as a Bearer token.
CRON_SECRET="change-me-random-cron-secret"

# Anthropic — https://console.anthropic.com  (scoring + cover letters)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-5"

# ─────────────────────────────────────────────────────────────
# EMAIL  — applications are SENT FROM YOUR OWN GMAIL, so replies
# land in your real inbox. Needs a Google App Password (2FA on).
# https://myaccount.google.com/apppasswords
# ─────────────────────────────────────────────────────────────
GMAIL_ADDRESS="you@gmail.com"
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
GMAIL_FROM_NAME="Your Full Name"

# ─────────────────────────────────────────────────────────────
# NOTIFICATIONS — Telegram is instant and free. Talk to
# @BotFather to create a bot, then @userinfobot for your chat id.
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
TELEGRAM_CHAT_ID="123456789"

# ─────────────────────────────────────────────────────────────
# JOB SOURCES
# ─────────────────────────────────────────────────────────────
# Adzuna (UK + most of EU) — https://developer.adzuna.com  free
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
# Reed.co.uk (UK only) — https://www.reed.co.uk/developers  free
REED_API_KEY=""
# Jooble (optional) — https://jooble.org/api/about
JOOBLE_API_KEY=""
# Comma-separated Greenhouse / Lever / Ashby board tokens to watch directly.
# e.g. GREENHOUSE_BOARDS="monzo,wise,cloudflare"
GREENHOUSE_BOARDS=""
LEVER_BOARDS=""
ASHBY_BOARDS=""
